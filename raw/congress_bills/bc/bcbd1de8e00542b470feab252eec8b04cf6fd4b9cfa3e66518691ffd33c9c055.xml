    <summaries>
      <summary>
        <versionCode>00</versionCode>
        <actionDate>2025-01-08</actionDate>
        <actionDesc>Introduced in Senate</actionDesc>
        <updateDate>2025-02-28T18:47:37Z</updateDate>
        <text><![CDATA[<p><strong>Local Access to Courts Act or LACA</strong></p><p>This bill adds College Station to the list of places where court must be held in the Galveston Division of the Southern District of Texas.&nbsp;</p><p>Additionally, the bill adds El Centro to the list of places where court must be held in the Southern District of California.&nbsp;</p><p>&nbsp;</p>]]></text>
      </summary>
      <summary>
        <versionCode>49</versionCode>
        <actionDate>2026-09-16</actionDate>
        <actionDesc>Public Law</actionDesc>
        <updateDate>2026-09-18T18:39:16Z</updateDate>
        <text><![CDATA[<p><strong>Local Access to Courts Act or LACA</strong></p><p>This act adds College Station to the list of places where court must be held in the Galveston Division of the Southern District of Texas.</p><p>Additionally, the act adds El Centro to the list of places where court must be held in the Southern District of California.&nbsp;</p>]]></text>
      </summary>
