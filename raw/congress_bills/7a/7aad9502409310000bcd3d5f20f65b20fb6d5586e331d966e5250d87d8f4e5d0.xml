    <summaries>
      <summary>
        <versionCode>00</versionCode>
        <actionDate>2025-02-05</actionDate>
        <actionDesc>Introduced in House</actionDesc>
        <updateDate>2025-03-25T16:44:21Z</updateDate>
        <text><![CDATA[<p><strong>Modernizing the Veterans On-Campus Experience Act of 2025</strong></p><p>This bill removes the requirement that educational and vocational counseling services provided by the Department of Veterans Affairs (VA) on&nbsp;campus at institutions of higher learning must be provided by VA counselors.</p>]]></text>
      </summary>
