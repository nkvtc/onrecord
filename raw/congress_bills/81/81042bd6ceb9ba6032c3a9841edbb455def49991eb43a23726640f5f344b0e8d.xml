    <summaries>
      <summary>
        <versionCode>00</versionCode>
        <actionDate>2025-03-14</actionDate>
        <actionDesc>Introduced in House</actionDesc>
        <updateDate>2026-04-06T13:05:56Z</updateDate>
        <text><![CDATA[<p><strong>Diesel Emissions Reduction Act of 2025 </strong></p><p>This bill reauthorizes through FY2029 a diesel emissions reduction program under which the Environmental Protection Agency provides grants, rebates, or loans for replacing diesel engines or retrofitting the engines with pollution control technologies.</p>]]></text>
      </summary>
